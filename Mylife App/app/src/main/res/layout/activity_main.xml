<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mylife_pink_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:paddingTop="30dp"
        android:paddingBottom="28dp">

        <!-- LOGOTIPO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦  MYLIFE  ✦"
            android:textColor="@color/mylife_pink_strong"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.25" />

        <!-- ESPACIO DECORATIVO SUPERIOR -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="♡                         ✧"
            android:textColor="@color/mylife_pink"
            android:textSize="25sp"
            android:gravity="center"
            android:layout_marginTop="18dp" />

        <!-- MOCHI -->
        <FrameLayout
            android:layout_width="245dp"
            android:layout_height="245dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_mochi_registro"
            android:elevation="6dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/cerdito_estudiando_fondoblanco"
                android:scaleType="fitCenter"
                android:padding="30dp"
                android:contentDescription="Mochi, mascota de MyLife" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:text="♥"
                android:textColor="@color/mylife_pink_strong"
                android:textSize="20sp"
                android:background="@drawable/bg_corazon_registro" />

            <TextView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="bottom|start"
                android:gravity="center"
                android:text="✦"
                android:textColor="@color/mylife_pink_strong"
                android:textSize="22sp" />

        </FrameLayout>

        <!-- BIENVENIDA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Bienvenido a MyLife!"
            android:textColor="@color/mylife_pink_strong"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tu vida, tus metas, tu espacio."
            android:textColor="@color/mylife_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Organiza tus días, crea hábitos y transforma\ntus pequeños pasos en grandes logros."
            android:textColor="@color/mylife_text_soft"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="30dp" />

        <!-- BOTONES DE ACCESO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_tarjeta_registro"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¡Comencemos!"
                android:textColor="@color/mylife_text"
                android:textSize="19sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="17dp" />

            <!-- INICIAR SESIÓN -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="Iniciar sesión  ♡"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_boton_registro"
                android:elevation="2dp" />

            <!-- CREAR CUENTA -->
            <Button
                android:id="@+id/btnRegistro"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="Crear una cuenta  ✿"
                android:textColor="@color/mylife_text"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/mylife_mint"
                android:layout_marginTop="13dp"
                android:elevation="2dp" />

        </LinearLayout>

        <!-- FRASE FINAL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✧  Pequeños pasos, grandes logros.  ✧"
            android:textColor="@color/mylife_pink_strong"
            android:textSize="13sp"
            android:textStyle="italic"
            android:gravity="center"
            android:layout_marginTop="27dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HECHO CON AMOR  ♡"
            android:textColor="@color/mylife_text_soft"
            android:textSize="9sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="13dp" />

    </LinearLayout>

</ScrollView>
