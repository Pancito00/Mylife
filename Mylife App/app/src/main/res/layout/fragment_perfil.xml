<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TARJETA DE PERFIL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card_rosa"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/imgCerditoPerfil"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:contentDescription="Mochi, mascota de MyLife"
                android:scaleType="fitCenter"
                android:src="@drawable/cerdito_feliz" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="¡Hola! ♡"
                android:textColor="#D96C93"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNombreUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Tu nombre"
                android:textColor="#674653"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCorreoUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="correo@ejemplo.com"
                android:textColor="#A87587"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cada pequeño paso cuenta 🌷"
                android:textColor="#A87587"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnEditarPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_boton_rosa"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:text="✎  Editar perfil"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ESTADÍSTICAS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="12dp"
            android:text="Mis logros ✨"
            android:textColor="#D96C93"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- TAREAS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rosa"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textColor="#D96C93"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/txtTareasCompletadas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#674653"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tareas completadas"
                    android:textColor="#A87587"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- HÁBITOS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rosa"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♡"
                    android:textColor="#D96C93"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/txtHabitosCompletados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#674653"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hábitos cumplidos"
                    android:textColor="#A87587"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- PROGRESO SEMANAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_rosa"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mi progreso semanal 🌸"
                android:textColor="#674653"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progresoSemanal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="15dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#F8DCE7"
                android:progressTint="#E88EAE" />

            <TextView
                android:id="@+id/txtPorcentajeProgreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="¡Vamos por más! ♡"
                android:textColor="#A87587"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- MI CUENTA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="12dp"
            android:text="Mi cuenta"
            android:textColor="#D96C93"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rosa"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/btnAcercaDe"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="15dp"
                android:text="✧    Acerca de MyLife"
                android:textColor="#674653"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F8DCE7" />

            <TextView
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="15dp"
                android:text="↩    Cerrar sesión"
                android:textColor="#C4607F"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PIE DE PÁGINA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="MyLife ♡ Organiza tus días, construye tus sueños."
            android:textColor="#C58A9F"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
