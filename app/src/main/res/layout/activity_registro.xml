<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mylife_pink_bg"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="28dp"
        android:paddingBottom="25dp">

        <!-- DECORACIÓN SUPERIOR -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦  MYLIFE  ✦"
            android:textColor="@color/mylife_pink_strong"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:layout_gravity="center_horizontal" />

        <!-- MASCOTA -->
        <FrameLayout
            android:layout_width="155dp"
            android:layout_height="155dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_mochi_registro"
            android:elevation="5dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/cerdito_estudiando_fondoblanco"
                android:scaleType="fitCenter"
                android:padding="25dp"
                android:contentDescription="Mochi, mascota de MyLife" />

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:text="♥"
                android:textColor="@color/mylife_pink_strong"
                android:textSize="17sp"
                android:background="@drawable/bg_corazon_registro" />

        </FrameLayout>

        <!-- BIENVENIDA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Qué alegría tenerte aquí!"
            android:textColor="@color/mylife_pink_strong"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crea tu cuenta y comienza a darle\norden a tus días."
            android:textColor="@color/mylife_text_soft"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="25dp" />

        <!-- TARJETA DEL REGISTRO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_tarjeta_registro"
            android:elevation="5dp">

            <!-- ENCABEZADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:background="@drawable/bg_icono_registro">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✿"
                        android:textColor="@color/mylife_pink_strong"
                        android:textSize="23sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tus datos"
                        android:textColor="@color/mylife_text"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Completa tu información"
                        android:textColor="@color/mylife_text_soft"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- NOMBRE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✧  Nombre completo"
                android:textColor="@color/mylife_text"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/txtNombre"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="¿Cómo te llamas?"
                android:inputType="textPersonName|textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/mylife_text"
                android:textColorHint="@color/mylife_text_soft"
                android:textSize="14sp"
                android:background="@drawable/bg_campo_registro"
                android:singleLine="true" />

            <!-- CORREO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✧  Correo electrónico"
                android:textColor="@color/mylife_text"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/txtCorreo"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="ejemplo@correo.com"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/mylife_text"
                android:textColorHint="@color/mylife_text_soft"
                android:textSize="14sp"
                android:background="@drawable/bg_campo_registro"
                android:singleLine="true" />

            <!-- CONTRASEÑA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✧  Contraseña"
                android:textColor="@color/mylife_text"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/txtContrasena"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Crea una contraseña"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/mylife_text"
                android:textColorHint="@color/mylife_text_soft"
                android:textSize="14sp"
                android:background="@drawable/bg_campo_registro"
                android:singleLine="true" />

            <!-- CONFIRMAR CONTRASEÑA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✧  Confirmar contraseña"
                android:textColor="@color/mylife_text"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/txtConfirmarContrasena"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Escribe tu contraseña otra vez"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/mylife_text"
                android:textColorHint="@color/mylife_text_soft"
                android:textSize="14sp"
                android:background="@drawable/bg_campo_registro"
                android:singleLine="true" />

            <!-- BOTÓN -->
            <Button
                android:id="@+id/btnCrearCuenta"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Crear mi cuenta  ♥"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_boton_registro"
                android:layout_marginTop="28dp"
                android:elevation="3dp" />

            <!-- NOTA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="♡  Tu espacio personal comienza aquí"
                android:textColor="@color/mylife_text_soft"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="14dp" />

        </LinearLayout>

        <!-- INICIAR SESIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Ya formas parte de MyLife?"
                android:textColor="@color/mylife_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtIniciarSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Inicia sesión"
                android:textColor="@color/mylife_pink_strong"
                android:textStyle="bold"
                android:textSize="13sp"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HECHO CON AMOR  ♡"
            android:textColor="@color/mylife_text_soft"
            android:textSize="9sp"
            android:letterSpacing="0.2"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp" />

    </LinearLayout>

</ScrollView>
