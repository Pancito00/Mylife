<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mylife_pink_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="30dp"
        android:paddingBottom="25dp">

        <!-- ENCABEZADO MYLIFE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦  MYLIFE  ✦"
            android:textColor="@color/mylife_pink_strong"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:layout_gravity="center_horizontal" />

        <!-- IMAGEN DE MOCHI -->
        <FrameLayout
            android:layout_width="175dp"
            android:layout_height="175dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_mochi_registro"
            android:elevation="5dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/cerdito_estudiando_fondoblanco"
                android:scaleType="fitCenter"
                android:padding="27dp"
                android:contentDescription="Mochi, mascota de MyLife" />

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:text="♥"
                android:textColor="@color/mylife_pink_strong"
                android:textSize="18sp"
                android:background="@drawable/bg_corazon_registro" />

        </FrameLayout>

        <!-- BIENVENIDA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Qué bueno verte de nuevo!"
            android:textColor="@color/mylife_pink_strong"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tu espacio, tus metas y tus momentos\nte están esperando."
            android:textColor="@color/mylife_text_soft"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp" />

        <!-- TARJETA DE INICIO DE SESIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="23dp"
            android:background="@drawable/bg_tarjeta_registro"
            android:elevation="5dp">

            <!-- ENCABEZADO DE LA TARJETA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="43dp"
                    android:layout_height="43dp"
                    android:gravity="center"
                    android:background="@drawable/bg_icono_registro">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="♡"
                        android:textColor="@color/mylife_pink_strong"
                        android:textSize="25sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inicia sesión"
                        android:textColor="@color/mylife_text"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ingresa a tu cuenta"
                        android:textColor="@color/mylife_text_soft"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- CORREO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✧  Correo electrónico"
                android:textColor="@color/mylife_text"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="27dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/txtCorreo"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="ejemplo@correo.com"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/mylife_text"
                android:textColorHint="@color/mylife_text_soft"
                android:textSize="14sp"
                android:background="@drawable/bg_campo_registro"
                android:singleLine="true" />

            <!-- CONTRASEÑA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✧  Contraseña"
                android:textColor="@color/mylife_text"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/txtContrasena"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Ingresa tu contraseña"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/mylife_text"
                android:textColorHint="@color/mylife_text_soft"
                android:textSize="14sp"
                android:background="@drawable/bg_campo_registro"
                android:singleLine="true" />

            <!-- BOTÓN DE ACCESO -->
            <Button
                android:id="@+id/btnIniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Entrar a MyLife  ♥"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_boton_registro"
                android:layout_marginTop="29dp"
                android:elevation="3dp" />

            <!-- FRASE INFERIOR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="♡  Nos alegra que estés aquí"
                android:textColor="@color/mylife_text_soft"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="15dp" />

        </LinearLayout>

        <!-- REGISTRO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="26dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Aún no tienes una cuenta?"
                android:textColor="@color/mylife_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtRegistrarse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Regístrate aquí"
                android:textColor="@color/mylife_pink_strong"
                android:textStyle="bold"
                android:textSize="13sp"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- PIE DE PÁGINA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HECHO CON AMOR  ♡"
            android:textColor="@color/mylife_text_soft"
            android:textSize="9sp"
            android:letterSpacing="0.2"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</ScrollView>
